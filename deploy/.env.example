# Copy to .env in the deploy directory on the server and fill in. Never commit the real file.

# --- Server ---
DOMAIN=aqrgo.com
PUBLIC_URL=https://aqrgo.com
POSTGRES_PASSWORD=change-me-long-random
# Set automatically by the deploy workflow; only needed for manual runs.
APP_IMAGE=ghcr.io/OWNER/REPO:latest

# Optional: only these emails can sign in (comma separated). Empty = anyone can sign up.
ALLOWED_EMAILS=

# --- AWS (SES emails + Bedrock AI) ---
AWS_REGION=us-east-1
# Region where SES (email) is set up, if different from AWS_REGION.
SES_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAIL_FROM=AQRGO CRM <no-reply@aqrgo.com>
# Bedrock API key (optional). Best kept as the GitHub secret AWS_BEARER_TOKEN_BEDROCK: each deploy writes it here.
# If set, Bedrock uses it instead of the access keys above.
# The access keys are still needed for SES emails.
AWS_BEARER_TOKEN_BEDROCK=
# Amazon Nova via Bedrock. Some regions need an inference profile id, e.g. us.amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# TypeSafe Jev (optional): skips non-leads and reads الحالة. Best kept as a GitHub secret.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0

# --- Google sign-in (optional) ---
# Authorised redirect URI in Google Cloud: https://aqrgo.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram bot (token from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# 16+ characters of letters, digits, _ or -
TELEGRAM_WEBHOOK_SECRET=
