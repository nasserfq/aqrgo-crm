{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AQRGO",
  "version": "1.1.3",
  "identifier": "com.aqrgo.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "AQRGO",
    "category": "Business",
    "shortDescription": "جدول العروض العقارية",
    "longDescription": "AQRGO CRM: جدول العروض العقارية، يُعبأ من الموقع أو من تيليجرام وواتساب.",
    "copyright": "© AQRGO",
    "homepage": "https://aqrgo.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "aqrgo-desktop"
        ]
      }
    }
  }
}
